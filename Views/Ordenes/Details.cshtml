@model WebApplication1.Models.Orden

@{
    ViewData["Title"] = "Detalle de Orden";
}

<div class="container mt-4">
    <h2>Orden #@Model.Id</h2>
    <p><strong>Cliente:</strong> @Model.Cliente?.Nombre</p>
    <p><strong>Estado:</strong> @Model.Estado</p>
    <p><strong>Fecha:</strong> @Model.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    <p><strong>Observaciones:</strong> @Model.Observaciones</p>
    <p><strong>Total:</strong> @Model.Total.ToString("C")</p>

    <h4 class="mt-4">Consumos de materiales</h4>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Material</th>
                <th>Cantidad</th>
                <th>Precio unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OrdenItems.Any())
            {
                foreach (var item in Model.OrdenItems)
                {
                    <tr>
                        <td>@item.Material.Descripcion</td>
                        <td>@item.Cantidad</td>
                        <td>@item.PrecioUnit.ToString("C")</td>
                        <td>@((item.Cantidad * item.PrecioUnit).ToString("C"))</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-muted">No hay consumos cargados para esta orden.</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex gap-2 mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar orden</a>
        <a asp-controller="OrdenItems" asp-action="Create" class="btn btn-success">Agregar consumo</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>
