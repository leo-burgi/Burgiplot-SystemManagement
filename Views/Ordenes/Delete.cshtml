@model WebApplication1.Models.Orden

@{
    ViewData["Title"] = "Eliminar Orden";
}

<div class="container mt-4">
    <h2>Eliminar orden #@Model.Id</h2>
    <p>¿Desea eliminar esta orden de trabajo?</p>

    <ul>
        <li><strong>Cliente:</strong> @Model.Cliente?.Nombre</li>
        <li><strong>Estado:</strong> @Model.Estado</li>
        <li><strong>Total:</strong> @Model.Total.ToString("C")</li>
    </ul>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
