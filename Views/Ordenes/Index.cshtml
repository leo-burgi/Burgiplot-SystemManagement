@model IEnumerable<WebApplication1.Models.Orden>

@{
    ViewData["Title"] = "Órdenes de trabajo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Órdenes de trabajo</h2>
        <a asp-action="Create" class="btn btn-success">+ Nueva orden</a>
    </div>

    @if (TempData["OrdenError"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Estado</th>
                <th>Observaciones</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Cliente?.Nombre</td>
                    <td>@item.Estado</td>
                    <td>@item.Observaciones</td>
                    <td>@item.Total.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
