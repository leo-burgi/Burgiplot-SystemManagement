@model IEnumerable<WebApplication1.Models.Material>

@{
    ViewData["Title"] = "Stock de materiales";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Control de stock</h2>
        <a asp-action="Create" class="btn btn-success">+ Nuevo material</a>
    </div>

    @if (TempData["MaterialError"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Código</th>
                <th>Descripción</th>
                <th>Unidad</th>
                <th>Precio</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="@(item.StockActual <= 5 ? "table-warning" : string.Empty)">
                    <td>@item.Codigo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Unidad</td>
                    <td>@item.PrecioStd?.ToString("C")</td>
                    <td>@item.StockActual</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
