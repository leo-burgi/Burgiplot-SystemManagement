@model WebApplication1.Models.Material

@{
    ViewData["Title"] = "Detalle Material";
}

<div class="container mt-4">
    <h2>@Model.Descripcion</h2>
    <ul class="list-group mb-3">
        <li class="list-group-item"><strong>Código:</strong> @Model.Codigo</li>
        <li class="list-group-item"><strong>Unidad:</strong> @Model.Unidad</li>
        <li class="list-group-item"><strong>Precio estándar:</strong> @Model.PrecioStd?.ToString("C")</li>
        <li class="list-group-item"><strong>Stock actual:</strong> @Model.StockActual</li>
        <li class="list-group-item"><strong>Actualizado:</strong> @Model.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
    </ul>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</div>
