@model WebApplication1.Models.Material

@{
    ViewData["Title"] = "Eliminar Material";
}

<div class="container mt-4">
    <h2>Eliminar material</h2>
    <p>¿Está seguro de eliminar <strong>@Model.Descripcion</strong>?</p>

    <ul>
        <li>Código: @Model.Codigo</li>
        <li>Unidad: @Model.Unidad</li>
        <li>Stock: @Model.StockActual</li>
    </ul>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
