@model WebApplication1.Models.Material

@{
    ViewData["Title"] = "Crear Material";
}

<div class="container mt-4">
    <h2>Nuevo material para ploteo/polarizado/tazas</h2>

    <form asp-action="Create" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" placeholder="VINILO-BRILLO" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Vinilo adhesivo brillo / Film polarizado / Taza sublimable" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Unidad" class="form-label"></label>
                <input asp-for="Unidad" class="form-control" placeholder="m2, metro, unidad" />
                <span asp-validation-for="Unidad" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PrecioStd" class="form-label"></label>
                <input asp-for="PrecioStd" class="form-control" />
                <span asp-validation-for="PrecioStd" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="StockActual" class="form-label"></label>
                <input asp-for="StockActual" class="form-control" />
                <span asp-validation-for="StockActual" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success">Guardar material</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
