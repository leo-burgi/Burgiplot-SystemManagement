@model IEnumerable<WebApplication1.Models.OrdenItem>

@{
    ViewData["Title"] = "Consumos por orden";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Consumos de materiales</h2>
        <a asp-action="Create" class="btn btn-success">+ Agregar consumo</a>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Orden</th>
                <th>Cliente</th>
                <th>Material</th>
                <th>Cantidad</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>OT-@item.OrdenId</td>
                    <td>@item.Orden?.Cliente?.Nombre</td>
                    <td>@item.Material?.Descripcion</td>
                    <td>@item.Cantidad</td>
                    <td>@item.PrecioUnit.ToString("C")</td>
                    <td>@((item.Cantidad * item.PrecioUnit).ToString("C"))</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detalle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
