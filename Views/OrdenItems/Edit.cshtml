@model WebApplication1.Models.OrdenItem

@{
    ViewData["Title"] = "Editar consumo";
}

<div class="container mt-4">
    <h2>Editar consumo</h2>

    <form asp-action="Edit" class="mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="OrdenId" class="form-label"></label>
                <select asp-for="OrdenId" class="form-select" asp-items="ViewBag.OrdenId"></select>
                <span asp-validation-for="OrdenId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MaterialId" class="form-label"></label>
                <select asp-for="MaterialId" class="form-select" asp-items="ViewBag.MaterialId"></select>
                <span asp-validation-for="MaterialId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PrecioUnit" class="form-label"></label>
                <input asp-for="PrecioUnit" class="form-control" />
                <span asp-validation-for="PrecioUnit" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
